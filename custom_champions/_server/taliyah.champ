# LOCAL TEST COPY of League of Legends' Taliyah (Riot Games IP) - never publish. Engine test only.
# Numbers: LoL wiki Taliyah/LoL (current patch, read 2026-10-30). Rank-1 values; per-rank growth via *_rank fields.
#
# UNITS (checked against the built-ins, e.g. Stone Warden hp 66'000 = "hp = 660"; skill dmg/range are plain LoL-like numbers)
#   hp, attack, defence, elemental_defence, move_speed, *_per_level: LoL value 1:1 (the parser multiplies by 100)
#   attack_range is EDGE to edge; ranged built-ins use about the LoL value (Cinder Oracle 520) -> 525
#   attack_speed = base AS x 100 (0.658 -> 66). Skill ranges/widths: LoL units = game units. Times: ms.
#   Ratios: ep = % of elemental power (= AP), ad = % attack. dmg_rank = damage added per rank above 1.
#   Mana: the engine's Earth resource has no mana pool, so every cost = 0 (LoL costs listed in comments).
#
# KEY LAYOUT: the Q key is a Q option and cannot be custom, so it is a filler (Rock Throw). The LoL kit sits on
#   W = LoL Q, E = LoL W, R = LoL E, Y = LoL R (ultimate), T = rock-surf boost, P = passive.
base = Basalt Hermit
name = Taliyah
hp = 550
hp_per_level = 104
attack = 58
attack_per_level = 3
ep_per_level = 3
defence = 18
elemental_defence = 28
move_speed = 330
attack_range = 525
attack_speed = 66
colour = b8956a
crits = 1                # [U-463] LoL champion: crit chance 0 %, crit damage 175 % (items add chance)
q1 = Rock Throw
q2 = Lift and Throw
q3 = Stone Push

# ---- LoL Q Threaded Volley -> key W. 7/6/5/4/3 s, cast 0.25, range 1000, width 200, speed 3600..1800, mana 55..75,
#   5 stones: first 55/72.5/90/107.5/125 +50 % AP, others 22..50 +20 % AP; total 143..325 +130 % AP.
#   Used: 5 casts, the AVERAGE stone = 29 (+9 per rank) + 26 % AP.
w = Cinder Volley
w.name = Threaded Volley
w.desc = Five stones in a row, recast to throw each
w.kind = Bolt
w.sub = Earth
w.dmg = 29
w.dmg_rank = 9
w.ep = 26
w.ad = 0
w.range = 1000
w.width = 200
w.speed = 2800
w.cast_ms = 250
w.cd_ms = 7000
w.cd_rank = -1000
w.cost = 0
w.casts = 5
w.recast_ms = 1500
w.move = Rooted
# approximation: stones are thrown by recasts (LoL fires them by itself); no Worked Ground (boulder, 50 % cooldown),
#   no 20..40 % slow from the boulder, no stone detonation. Single-target bolt, not the 175 radius.
w_rank_step = 2
w_rank_cap = 1

