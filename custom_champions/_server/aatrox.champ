# cast 1 = a line, cast 2 = a cone (sweet spot = the outer edge), cast 3 = a circle with the sweet spot in the MIDDLE.
# approximation: Aatrox does not step forward with each cast.
w_rank_step = 2          # LoL: a new rank every 2 levels ...
w_rank_cap = 1           # ... max rank 1 at level 1 (rank 5 at level 9; the engine would go on past 5)

