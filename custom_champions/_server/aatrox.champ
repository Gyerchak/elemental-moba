# ---- Passive Deathbringer Stance: every 16 s the next auto deals +7 % max HP and heals for it.
p = Chi Flow
p.name = Deathbringer Stance
p.desc = Every 16 s the next autoattack deals +7 % of the target's max HP and heals for all of it
# [U-416] passive proc: trigger 1 = the next autoattack, its own cooldown — shown on the P icon [U-457].
# LoL: 4-13 % max HP, 24-12 s by level — approximation: a fixed middle value.
